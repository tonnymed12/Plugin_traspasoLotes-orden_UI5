<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:html="http://www.w3.org/1999/xhtml"
    controllerName="serviacero.custom.plugins.zpluginTraspasoLoteOrden.zpluginTraspasoLoteOrden.controller.MainView"
    width="100%"
    height="100%">

    <Panel
        id="panelPlugin"
        width="100%"
        height="100%"
        expandable="false"
        accessibleRole="Region"
        backgroundDesign="Transparent"
        class="sapUiNoContentPadding">

        <headerToolbar>
            <Toolbar height="3rem">
                <Button id="backButton"  visible="false" text="{i18n>back.btn}"  tooltip="{i18n>back.tooltip}" icon="sap-icon://nav-back"  press="onBackPress"/>
                <Title  id="headerTitle" text=""/>
                <ToolbarSpacer/>
                <Button id="closeButton" visible="false" tooltip="{i18n>close.tooltip}" icon="sap-icon://decline" press="onClosePress"/>
            </Toolbar>
        </headerToolbar>

        <content>
            <!-- ═══════════════════════════════════════════
                 SECCIÓN 1 — Lotes escaneados en la operación actual
            ════════════════════════════════════════════ -->
            <Panel
                id="panelLotesOrigen"
                width="100%"
                expandable="true"
                expanded="true"
                headerText="{i18n>lotesOrigen.title}"
                backgroundDesign="Solid"
                class="sapUiSmallMarginBottom">
                <content>
                    <Table
                        id="idLotesOrigenTable"
                        items="{lotesOrigen>/items}"
                        width="100%"
                        alternateRowColors="true"
                        noDataText="{i18n>noLotesOrigen}">
                        <headerToolbar>
                            <Toolbar>
                                <Title text="{i18n>lotesOrigen.tableTitle}"/>
                                <ToolbarSpacer/>
                                <Button
                                    id="refreshLotesBtn"
                                    icon="sap-icon://refresh"
                                    text="{i18n>refresh}"
                                    press="onRefreshLotesOrigen"
                                    type="Attention"/>
                            </Toolbar>
                        </headerToolbar>
                        <columns>
                            <Column width="5%"  hAlign="Center"><Text text="{i18n>col.secuencia}"/></Column>
                            <Column width="25%" hAlign="Left">  <Text text="{i18n>col.material}"/></Column>
                            <Column width="20%" hAlign="Left">  <Text text="{i18n>col.lote}"/></Column>
                            <Column width="15%" hAlign="Right"> <Text text="{i18n>col.cantidad}"/></Column>
                            <Column width="10%" hAlign="Left">  <Text text="{i18n>col.uom}"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem vAlign="Middle">
                                <cells>
                                    <Text text="{lotesOrigen>secuencia}"/>
                                    <Text text="{lotesOrigen>material}"/>
                                    <Text text="{lotesOrigen>lote}"/>
                                    <!-- <Text text="{lotesOrigen>cantidad}"/> -->
                                    <ObjectNumber
                                        number="{path: 'lotesOrigen>cantidad', type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 0, maxFractionDigits: 3, groupingEnabled: true}}" />
                                    <Text text="{lotesOrigen>uom}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
            </Panel>

            <!-- ═══════════════════════════════════════════
                 SECCIÓN 2 — Filtros para buscar la orden destino
            ════════════════════════════════════════════ -->
            <Panel
                id="panelFiltros"
                width="100%"
                expandable="true"
                expanded="true"
                headerText="{i18n>filtros.title}"
                backgroundDesign="Solid"
                class="sapUiSmallMarginBottom">
                <content>
                    <HBox
                        width="100%"
                        alignItems="End"
                        wrap="Wrap"
                        class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">

                        <VBox width="40%" class="sapUiSmallMarginEnd">
                            <Label text="{i18n>filtro.orden}" labelFor="inputOrden"/>
                            <Input id="inputOrden" placeholder="{i18n>filtro.orden.placeholder}" submit="onBuscarOrdenes"/>
                        </VBox>

                        <VBox justifyContent="End">
                            <Button
                                id="btnBuscar"
                                text="{i18n>btn.buscar}"
                                icon="sap-icon://search"
                                type="Emphasized"
                                press="onBuscarOrdenes"/>
                        </VBox>
                    </HBox>
                </content>
            </Panel>

            <!-- ═══════════════════════════════════════════
                 SECCIÓN 3 — Tabla de órdenes destino
            ════════════════════════════════════════════ -->
            <Panel
                id="panelOrdenes"
                width="100%"
                expandable="false"
                backgroundDesign="Solid">
                <content>
                    <Table
                        id="idOrdenesTable"
                        items="{ordenes>/items}"
                        width="100%"
                        alternateRowColors="true"
                        noDataText="{i18n>noOrdenes}"
                        mode="SingleSelectMaster"
                        selectionChange="onOrdenSelectionChange"
                        growing="true"
                        growingThreshold="20">
                        <headerToolbar>
                            <Toolbar>
                                <Title text="{i18n>ordenes.tableTitle}"/>
                                <ToolbarSpacer/>
                                <Button
                                    id="btnTraspasar"
                                    text="{i18n>btn.traspasar}"
                                    icon="sap-icon://forward"
                                    type="Accept"
                                    enabled="{ordenes>/ordenSeleccionada}"
                                    press="onTraspasar"/>
                            </Toolbar>
                        </headerToolbar>
                        <columns>
                            <Column width="15%" hAlign="Left"><Text text="{i18n>col.orden}"/></Column>
                            <Column width="15%" hAlign="Left"><Text text="{i18n>col.material}"/></Column>
                            <Column width="30%" hAlign="Left"><Text text="{i18n>col.descripcion}"/></Column>
                            <Column width="15%" hAlign="Right"><Text text="{i18n>col.cantidadPlaneada}"/></Column>
                            <Column width="10%" hAlign="Left"><Text text="{i18n>col.uom}"/></Column>
                            <Column width="15%" hAlign="Center"><Text text="{i18n>col.status}"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem
                                vAlign="Middle"
                                type="Active">
                                <cells>
                                    <Text text="{ordenes>order}"/>
                                    <Text text="{ordenes>material/material}"/>
                                    <Text text="{ordenes>material/description}"/>
                                    <!-- <Text text="{ordenes>productionQuantity}"/> -->
                                    <ObjectNumber
                                        number="{path: 'ordenes>productionQuantity', type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 0, maxFractionDigits: 3, groupingEnabled: true}}"/>
                                    <Text text="{ordenes>productionUnitOfMeasure}"/>
                                    <ObjectStatus
                                        text="{ordenes>executionStatus}"
                                        state="{path: 'ordenes>executionStatus', formatter: '.formatter.orderStatusState'}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
            </Panel>
        </content>
    </Panel>

</mvc:View>
